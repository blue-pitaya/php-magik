target/

# tree-sitter: only need lib/include, lib/src, and the built .a
tree-sitter/*
!tree-sitter/lib/
tree-sitter/lib/*
!tree-sitter/lib/include/
!tree-sitter/lib/src/
tree-sitter/lib/src/*.o
!tree-sitter/libtree-sitter.a

# tree-sitter-php: only need common/, php/src/, php_only/src/, queries/
tree-sitter-php/*
!tree-sitter-php/common/
!tree-sitter-php/php/
tree-sitter-php/php/*
!tree-sitter-php/php/src/
!tree-sitter-php/php_only/
tree-sitter-php/php_only/*
!tree-sitter-php/php_only/src/
!tree-sitter-php/queries/
